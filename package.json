{
  "name": "nivel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "db:seed": "tsx scripts/db-reset.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "drizzle-orm": "0.45.4",
    "nanoid": "6.0.2",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
